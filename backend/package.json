{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "server/server.js",
  "scripts": {
    "start": "node --env-file=.env server/server.js",
    "dev": "node --watch --env-file=.env server/server.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "jest --watch",
    "db:up": "docker compose --env-file .env -f ../docker-compose.yml up -d",
    "db:down": "docker compose --env-file .env -f ../docker-compose.yml down",
    "db:wipe": "docker compose --env-file .env -f ../docker-compose.yml down -v && docker compose --env-file .env -f ../docker-compose.yml up -d",
    "db:migrate:down": "docker exec -i sonoma_postgres sh -c 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\"' < db/migration_down.sql",
    "db:migrate:up": "docker exec -i sonoma_postgres sh -c 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\"' < db/migration_up.sql",
    "db:seed": "docker exec -i sonoma_postgres sh -c 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\"' < db/seed.sql",
    "db:reset": "npm run db:migrate:down && npm run db:migrate:up && npm run db:seed"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14"
  }
}